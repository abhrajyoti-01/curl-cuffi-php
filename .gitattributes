# Same line endings on every OS (Windows checkouts included), so fixtures and
# the parity reference read the same everywhere.
* text=auto eol=lf

# Left out of the Composer package (dist archives)
/.github export-ignore
/tests export-ignore
/tools export-ignore
/.gitattributes export-ignore
/.gitignore export-ignore
/phpunit.xml export-ignore
/RELEASING.md export-ignore
